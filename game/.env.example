# ===========================================
# Sol2Earn.fun - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# Solana Treasury Wallet (receives entry fees + platform fees)
TREASURY_WALLET=

# Server Hot Wallet private key (base58 encoded) for automated payouts
# KEEP THIS SECRET. Never commit to version control.
SERVER_PRIVATE_KEY=

# Platform fee in SOL (charged on top of entry fee, non-refundable)
# Default: 0.0008 SOL (~€0.10 at ~€130/SOL)
PLATFORM_FEE_SOL=0.0008

# Solana network: mainnet-beta, devnet, testnet
SOLANA_NETWORK=mainnet-beta

# Solana RPC endpoint (optional, defaults based on network)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Admin panel passwords
ADMIN_PASS=DEFAULT
SUPER_ADMIN_PASS=superadmin123

# Debug mode (set to false in production!)
DEBUG_MODE=false
